# Copy to .env.local and fill in. Never commit real secrets.

# --- Database (NeonDB / Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth ---
# 32+ char random string used to sign session JWTs.
SESSION_SECRET=""

# --- Kinguin ESA Integration API ---
KINGUIN_API_BASE="https://gateway.kinguin.net/esa/api/v1"
KINGUIN_API_KEY=""
KINGUIN_STORE_ID=""
KINGUIN_STORE_NAME=""
KINGUIN_CLIENT_ID=""
KINGUIN_CLIENT_SECRET=""

# --- SMTP (order confirmations, key delivery) ---
SMTP_HOST="mail.spacemail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Prontoware Games <info@prontowaregames.com>"
